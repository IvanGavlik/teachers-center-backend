   :content "present perfect vs past simple, 5 slides, lots of examples"}
  {:id :en-b1-food-vocab  :language "English" :level "B1" :age-group "teenagers" :native-language "No"       :expect :slides
   :content "food and cooking vocabulary, 5 slides"}
