   :content "treba mi gramatika"}]

 ;; Edits run against a slide of a deck generated above.
 ;; :slide picks the first slide with that layout (falls back to slide 0).
 :edit
 [{:id :edit-to-table     :deck :en-b1-food-vocab     :slide "bullets"    :content "make this a table"}
  {:id :edit-add-example  :deck :en-a2-past-simple    :slide "examples"   :content "add one more example with the verb 'go'"}
  {:id :edit-to-comparison :deck :de-a2-separable     :slide "bullets"    :content "show correct and wrong sentences instead"}]}
