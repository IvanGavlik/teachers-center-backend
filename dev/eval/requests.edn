;;          :clarify → should ask a clarification question
{:generate
 [;; ── English ──
  {:id :en-a1-to-be       :language "English" :level "A1" :age-group "children"  :native-language "No"       :expect :slides
   :content "verb to be (am, is, are), 4 slides"}
  {:id :en-a2-past-simple :language "English" :level "A2" :age-group "teenagers" :native-language "No"       :expect :slides
   :content "Past simple regular and irregular verbs - 6 slides please"}
