{:paths ["src" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.11.1"}
        
        ;; Web server stack
        http-kit/http-kit {:mvn/version "2.3.0"}
        ring/ring-core {:mvn/version "1.10.0"}
        ring/ring-json {:mvn/version "0.5.1"}
        javax.servlet/javax.servlet-api {:mvn/version "4.0.1"} ; ring.middleware.multipart-params needs this at compile time even though we never run under a servlet container
        compojure/compojure {:mvn/version "1.7.0"}
        ring-cors/ring-cors {:mvn/version "0.1.13"}
        
        ;; System management
        integrant/integrant {:mvn/version "0.8.0"}
        aero/aero {:mvn/version "1.1.6"}
        
        ;; HTTP client for OpenAI
        clj-http/clj-http {:mvn/version "3.12.3"}
        
        ;; JSON handling
        cheshire/cheshire {:mvn/version "5.12.0"}
        
        ;; PDF page images for book conversion (doc/book-ocr-investigation.md)
        org.apache.pdfbox/pdfbox {:mvn/version "3.0.3"}
        ;; black-and-white scans are often JBIG2 images, which PDFBox can't decode without this
        org.apache.pdfbox/jbig2-imageio {:mvn/version "3.0.4"}

        ;; Environment variables
        io.github.cdimascio/dotenv-java {:mvn/version "3.2.0"}
        
        ;; Logging
        org.clojure/tools.logging {:mvn/version "1.2.4"}
        ch.qos.logback/logback-classic {:mvn/version "1.4.14"}}

 :aliases {:dev {:extra-paths ["dev"]
                  :jvm-opts ["-Dlogback.configurationFile=resources/logback.xml"]}
           :test {:extra-paths ["test"]
                  :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                               io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :exec-fn cognitect.test-runner.api/test}

           :repl {:main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]
                  :extra-deps {integrant/repl {:mvn/version "0.3.3"}
                               nrepl/nrepl {:mvn/version "1.0.0"}
                               cider/cider-nrepl {:mvn/version "0.42.1"}
                               stylefruits/gniazdo {:mvn/version "1.2.0"}  ; test web sockets
                               }}}}